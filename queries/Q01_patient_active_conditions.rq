# Q01 — Patient — Simple
# What active conditions are currently recorded in my health record?

PREFIX syn: <http://example.org/synthea/vocab/>

SELECT ?condition ?conditionName ?onset
WHERE {
  GRAPH ?g {
    ?condition
      syn:subject <http://example.org/synthea/data/Patient/{{PATIENT_ID}}> ;
      syn:conditionName ?conditionName ;
      syn:clinicalStatus "active" ;
      syn:onsetDateTime ?onset .
  }
}
ORDER BY ?onset
